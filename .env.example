# Credenciales y parametros de la tienda online.
# Copia este archivo a .env (que esta en .gitignore) y ajusta los valores:
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
# docker compose lee .env automaticamente para sustituir las variables.

# --- PostgreSQL (puerto del host 5444) ---
DB_NAME=pedidos_db
DB_USER=admin
DB_PASSWORD=secretpassword123

# --- RabbitMQ (puerto del host 5674, consola 15674) ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secretpassword123

# --- API (puerto del host 3000) ---
# Ventana para completar el pago de un pedido reservado, en minutos.
RESERVA_TTL_MINUTOS=15