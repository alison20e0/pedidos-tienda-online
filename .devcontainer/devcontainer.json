{
  "name": "pedidos-tienda-online",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 5444, 5674, 15674],
  "portsAttributes": {
    "3000": { "label": "pedidos-api" },
"5444": { "label": "postgres" },
      "5674": { "label": "rabbitmq-amqp" },
      "15674": { "label": "rabbitmq-management" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "eslint.validate": [
          "javascript",
          "typescript"
        ]
      }
    }
  },
  "remoteUser": "node"
}
